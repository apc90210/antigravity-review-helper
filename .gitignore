# Logs
logs/*.log
logs/*.txt

# Debug snapshots
debug_snapshots/*.txt
debug_snapshots/*.log

# Binaries and build artifacts
*.exe
*.dll
*.bin
*.zip
*.7z
*.msi
dist/
dist_test/
release/

# Scratch and dev-only files
scratch/

# PNG files (kept via explicit allow-list below)
*.png
!assets/buttons/*.png
!assets/alerts/*.png

# Secrets and credentials (extra safety)
.env
*.env
*.pem
*.key
*.p12

# Keep gitkeep placeholders
!logs/.gitkeep
!debug_snapshots/.gitkeep